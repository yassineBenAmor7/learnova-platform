generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id    Int      @id @default(autoincrement())
  name  RoleName @unique
  users User[]
}

model User {
  id                 Int                 @id @default(autoincrement())
  firstName          String
  lastName           String
  email              String              @unique
  password           String
  roleId             Int
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  avatar             String?
  bio                String?
  location           String?
  phone              String?
  certificates       Certificate[]
  courses            Course[]
  enrollments        Enrollment[]
  payments           Payment[]
  quizAttempts       QuizAttempt[]
  sessionCompletions     SessionCompletion[]
  sessionReadCompletions SessionReadCompletion[]
  role                   Role                    @relation(fields: [roleId], references: [id])
  gamification           UserGamification?
  videoWatches           VideoWatch[]
}

model Course {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  thumbnail    String?
  creatorId    Int
  createdAt    DateTime      @default(now())
  domain       String         @default("IT_DATA")
  isPaid       Boolean       @default(false)
  level        CourseLevel   @default(BEGINNER)
  price        Float         @default(0)
  recommended  Boolean       @default(false)
  certificates Certificate[]
  creator      User          @relation(fields: [creatorId], references: [id])
  enrollments  Enrollment[]
  payments     Payment[]
  quizzes      Quiz[]
  sessions     Session[]
}

model Session {
  id                     Int                     @id @default(autoincrement())
  title                  String
  description            String?
  orderNumber            Int
  courseId               Int
  content                String?
  course                 Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sessionCompletions     SessionCompletion[]
  sessionReadCompletions SessionReadCompletion[]
  quizzes                Quiz[]
  videos                 Video[]
}

model Video {
  id          Int          @id @default(autoincrement())
  title       String
  url         String
  duration    Int?
  orderNumber Int
  sessionId   Int
  content     String?
  description String?
  session     Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  watches     VideoWatch[]
}

model Enrollment {
  id         Int       @id @default(autoincrement())
  userId     Int
  courseId   Int
  enrolledAt DateTime  @default(now())
  course     Course    @relation(fields: [courseId], references: [id])
  user       User      @relation(fields: [userId], references: [id])
  progress   Progress?

  @@unique([userId, courseId])
}

model Progress {
  id                  Int        @id @default(autoincrement())
  enrollmentId        Int        @unique
  completedSessions   Int        @default(0)
  completedVideos     Int        @default(0)
  percentage          Float      @default(0)
  lastAccess          DateTime   @default(now())
  learningTimeSeconds Int        @default(0)
  enrollment          Enrollment @relation(fields: [enrollmentId], references: [id])
}

model Quiz {
  id                         Int           @id @default(autoincrement())
  title                      String
  description                String?
  courseId                   Int
  sessionId                  Int?
  createdAt                  DateTime      @default(now())
  passingScore               Float         @default(70)
  timeLimitMinutes           Int?
  isExamMode                 Boolean       @default(false)
  allowReviewAfterSubmission Boolean       @default(true)
  maxAttempts                Int?
  randomizeAnswers           Boolean       @default(true)
  randomizeQuestions         Boolean       @default(true)
  showExplanationAfterAnswer Boolean       @default(true)
  questions                  Question[]
  course                     Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session                    Session?      @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  attempts                   QuizAttempt[]
}

model Question {
  id      Int              @id @default(autoincrement())
  text    String
  quizId  Int
  quiz    Quiz             @relation(fields: [quizId], references: [id])
  options QuestionOption[]
  answers QuizAnswer[]
}

model QuestionOption {
  id          Int          @id @default(autoincrement())
  text        String
  isCorrect   Boolean      @default(false)
  questionId  Int
  explanation String?
  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  quizAnswers QuizAnswer[]
}

model QuizAttempt {
  id         Int          @id @default(autoincrement())
  userId     Int
  quizId     Int
  score      Float        @default(0)
  passed     Boolean      @default(false)
  startedAt  DateTime     @default(now())
  finishedAt DateTime?
  isExamMode Boolean      @default(false)
  expiresAt  DateTime?
  answers    QuizAnswer[]
  quiz       Quiz         @relation(fields: [quizId], references: [id])
  user       User         @relation(fields: [userId], references: [id])
}

model QuizAnswer {
  id         Int            @id @default(autoincrement())
  attemptId  Int
  questionId Int
  optionId   Int
  isCorrect  Boolean
  attempt    QuizAttempt    @relation(fields: [attemptId], references: [id])
  option     QuestionOption @relation(fields: [optionId], references: [id])
  question   Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Certificate {
  id                Int      @id @default(autoincrement())
  userId            Int
  courseId          Int
  certificateNumber String   @unique
  qrCode            String   @unique
  issuedAt          DateTime @default(now())
  course            Course   @relation(fields: [courseId], references: [id])
  user              User     @relation(fields: [userId], references: [id])
}

model UserGamification {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastActivityDate DateTime?
  user             User      @relation(fields: [userId], references: [id])
}

model SessionCompletion {
  id          Int      @id @default(autoincrement())
  userId      Int
  sessionId   Int
  completedAt DateTime @default(now())
  session     Session  @relation(fields: [sessionId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, sessionId])
}

model SessionReadCompletion {
  id          Int      @id @default(autoincrement())
  userId      Int
  sessionId   Int
  completedAt DateTime @default(now())
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
}

model VideoWatch {
  id             Int      @id @default(autoincrement())
  userId         Int
  videoId        Int
  watchedSeconds Int      @default(0)
  completed      Boolean  @default(false)
  lastWatchedAt  DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
  video          Video    @relation(fields: [videoId], references: [id])

  @@unique([userId, videoId])
}

model Payment {
  id            Int      @id @default(autoincrement())
  userId        Int
  courseId      Int
  amount        Float
  currency      String   @default("USD")
  status        String   @default("COMPLETED")
  paymentMethod String
  transactionId String   @unique
  createdAt     DateTime @default(now())
  course        Course   @relation(fields: [courseId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
}

enum RoleName {
  ADMIN
  LEARNER
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum CourseDomain {
  IT_DATA
  MARKETING
  FINANCE_BUSINESS
  MANAGEMENT
  DESIGN_CREATIVE
  LANGUAGE_COMMUNICATION
  HEALTH_WELLNESS
  PERSONAL_DEVELOPMENT
  ACADEMIC_SCIENCES
  MUSIC_ARTS
  SOFTWARE_ENGINEERING
  SALES_E_COMMERCE
  HUMANITIES_SOCIAL
  LAW_LEGAL
  LIFESTYLE_HOBBIES
}
